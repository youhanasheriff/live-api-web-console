# Environment Variables for Hybrid Pipeline
# Copy this file to .env.local and fill in your API keys

# Gemini API Key for conversation responses
# Create your own API KEY at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key for STT and TTS
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: OpenAI TTS Voice (default: alloy)
# Options: alloy, echo, fable, onyx, nova, shimmer
# OPENAI_TTS_VOICE=alloy

# Optional: OpenAI TTS Model (default: tts-1)
# Options: tts-1, tts-1-hd
# OPENAI_TTS_MODEL=tts-1

# Optional: OpenAI STT Model (default: whisper-1)
# OPENAI_STT_MODEL=whisper-1
